# Salin berkas ini menjadi .env lalu isi nilainya.
# Jangan pernah melakukan commit pada berkas .env.

# --- Wajib ---
# Token dari @BotFather di Telegram.
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chat ID admin untuk peringatan saat scraping gagal.
# Kirim pesan ke @userinfobot untuk mengetahui chat ID Anda.
ADMIN_CHAT_ID=123456789

# --- Penjadwalan (WIB) ---
# Jam berapa scraping harian berjalan.
SCRAPE_HOUR=7
SCRAPE_MINUTE=0

# --- Perilaku scraping ---
# Jumlah halaman per sumber per hari.
PAGES_PER_SOURCE=3

# Jeda acak antar request (detik). Jangan dikecilkan agar tetap sopan.
REQUEST_DELAY_MIN=2
REQUEST_DELAY_MAX=4

# Ambil halaman detail untuk mengekstrak skill? (1=ya, 0=tidak)
DETAIL_SCRAPING_ENABLED=1

# Batas jumlah halaman detail per run.
DETAIL_MAX_PER_RUN=30

# --- Opsional ---
# Jumlah run berturut-turut tanpa kemunculan sebelum lowongan ditandai
# tidak aktif.
# INACTIVE_AFTER_MISSES=3

# Koneksi ke Telegram. Default bawaan pustaka hanya 5 detik, yang sering
# membuat perintah gagal saat jaringan sedang lambat.
# TELEGRAM_CONNECT_TIMEOUT=20
# TELEGRAM_READ_TIMEOUT=20
# TELEGRAM_WRITE_TIMEOUT=20
# TELEGRAM_POOL_TIMEOUT=5

# Berapa kali request yang gagal karena jaringan diulang otomatis.
# TELEGRAM_MAX_RETRY=3
# TELEGRAM_RETRY_DELAY=1.5

# --- Dashboard web (opsional) ---
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_PORT=5000

# Tingkat log: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO
